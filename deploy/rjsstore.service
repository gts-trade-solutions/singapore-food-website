# systemd service that keeps the site running and starts it again after a crash or reboot.
# setup-server.sh installs it as /etc/systemd/system/rjsstore.service.
#   Status:  systemctl status rjsstore
#   Logs:    journalctl -u rjsstore -f

[Unit]
Description=RJS Store website (Next.js) for rjsstore.com
After=network.target

[Service]
Type=simple
User=rjsstore
WorkingDirectory=/var/www/rjsstore
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3100 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
