# WhatsApp number that receives orders, international format, digits only (no +, spaces or dashes).
# Example for a Singapore mobile: 6591234567
NEXT_PUBLIC_WHATSAPP_NUMBER=6500000000

# Public site URL, used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.rjsfoods.sg

# Set to "true" to show certification badges (e.g. halal) once certificates are confirmed.
NEXT_PUBLIC_SHOW_CERTIFICATIONS=false

# Optional, server-only: webhook that receives newsletter sign-ups as JSON { email, source }
# (e.g. a Zapier/Make hook or your email provider). Without it the form points people to WhatsApp.
NEWSLETTER_WEBHOOK_URL=
